{
  "name": "criza-web-recursos",
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/biblioteca", "destination": "/biblioteca.html" },
    { "source": "/aios-by-criza", "destination": "/aios-by-criza.html" }
  ]
}
